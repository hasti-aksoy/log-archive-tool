#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: ./log-archive <log-directory>"
    exit 1
fi

LOG_DIR="$1"
OUTPUT_DIR="$HOME/log-archives"
LOG_FILE="$OUTPUT_DIR/archive.log"

if [ ! -d "$LOG_DIR" ]; then
    echo "Error: '$LOG_DIR' is not a valid directory."
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
ARCHIVE_DATE=$(date +"%Y-%m-%d %H:%M:%S")

ARCHIVE_NAME="logs_archive_${TIMESTAMP}.tar.gz"
ARCHIVE_PATH="$OUTPUT_DIR/$ARCHIVE_NAME"

PARENT_DIR=$(dirname "$LOG_DIR")
DIR_NAME=$(basename "$LOG_DIR")

echo "Creating archive..."

if tar -czf "$ARCHIVE_PATH" -C "$PARENT_DIR" "$DIR_NAME"; then
    echo "Archive created successfully:"
    echo "$ARCHIVE_PATH"

    echo "[$ARCHIVE_DATE] Source: $LOG_DIR | Archive: $ARCHIVE_PATH" >> "$LOG_FILE"
else
    echo "Error: Failed to create archive."
    exit 1
fi
